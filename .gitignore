# Environment / secrets
.env
*.pem

# Raw & processed data (large / not to be committed)
data/raw/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep

# Reports & generated artifacts (regenerated by pipeline runs)
reports/*.json
reports/*.csv
!reports/.gitkeep
excel/*.xlsx
!excel/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# Airflow
dags/__pycache__/
airflow.db
airflow.cfg
logs/
standalone_admin_password.txt

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/
